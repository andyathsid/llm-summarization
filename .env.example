# Copy this file to .env and adjust values for your environment.

# Model provider: ollama or openrouter
PROVIDER=ollama

# Local Ollama configuration
OLLAMA_MODEL=LiquidAI/lfm2.5-2.6b:q4_k_m
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768

# Hosted OpenRouter configuration, required when PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Shared model and summarization settings
TOKENIZER_NAME=LiquidAI/LFM2.5-2.6B
MAX_OUTPUT_TOKENS=2048
SUMMARIZATION_TESTING=false

# PDF-QA benchmark inputs
PDFQA_CATEGORY=real-pdfQA
PDFQA_DATASET=FeTaQA
PDFQA_SAMPLE_SIZE=10
RECALL_AT=1,3,5
PDFQA_ARTIFACT_DIR=artifacts/pdfqa

# Benchmark chunk sizes
SUMMARY_CHUNK_TOKENS=12000
BASELINE_CHUNK_TOKENS=512

# Embedding model. Leave FASTEMBED_THREADS unset to auto-detect a CPU-based default.
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_THREADS=4

# PostgreSQL with pgvector. PGVECTOR_PORT must match the port in the connection string.
PGVECTOR_PORT=6024
PGVECTOR_CONNECTION_STRING=postgresql+psycopg://langchain:langchain@localhost:6024/langchain
PGVECTOR_COLLECTION=pdfqa_document_summaries

# true deletes and recreates the configured collection when the benchmark initializes it.
RESET_COLLECTION=true
